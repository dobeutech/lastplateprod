# =============================================================================
# SavePlate Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# In Replit, set these as Secrets in the Secrets tab.
# =============================================================================

# --- REQUIRED ---

# Supabase project URL (from Supabase dashboard > Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous/public key (from Supabase dashboard > Settings > API)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- OPTIONAL ---

# Sentry DSN for error monitoring (recommended for production)
# VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Intercom App ID for customer support chat
# VITE_INTERCOM_APP_ID=your_intercom_app_id_here

# --- FEATURE FLAGS ---

# Demo mode - MUST be false (or unset) in production
VITE_ENABLE_DEMO_MODE=false

# Application display name
VITE_APP_NAME=SavePlate

# Application version
VITE_APP_VERSION=1.0.0

# Enable analytics tracking (default: true)
VITE_ENABLE_ANALYTICS=true

# Enable audit logging (default: true)
VITE_ENABLE_AUDIT_LOG=true
